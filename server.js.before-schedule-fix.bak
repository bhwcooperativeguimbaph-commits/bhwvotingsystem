// --- DISCLOSE RESULTS & GENERATE REPORT ---
app.post('/api/admin/disclose-results', (req, res) => {
    const { electionId, providedTokens } = req.body;
    const reconstructedKey = providedTokens.map(t => t.trim()).sort().join('');
    
    let query = electionId === 'active' ? `SELECT * FROM ELECTION WHERE status = 'Active' LIMIT 1` : `SELECT * FROM ELECTION WHERE election_id = ?`;
    
    pool.query(query, electionId === 'active' ? [] : [electionId], (err, results) => {
        const elec = results ? results[0] : null;
        if (err || !elec) return res.status(400).json({ success: false, message: "Election not found." });
        
        // Build candidate tallies from the CANDIDATE table
        pool.query(`SELECT full_name, position FROM CANDIDATE WHERE election_id = ?`, [elec.election_id], (err, candRows) => {
            const tallies = {};
            if(candRows) {
                candRows.forEach(c => {
                    if (!tallies[c.position]) tallies[c.position] = {};
                    tallies[c.position][c.full_name] = 0;
                });
            }

            // Decrypt votes from the VOTE table
            pool.query(`SELECT encrypted_vote FROM VOTE WHERE election_id = ?`, [elec.election_id], (err, voteRows) => {
                let decryptionFailed = false;
                
                if(voteRows) {
                    voteRows.forEach(row => {
                        const clearTextChoice = decryptVote(row.encrypted_vote, reconstructedKey);
                        if (clearTextChoice === "DECRYPTION_FAILED") { decryptionFailed = true; return; }
                        
                        const voteData = JSON.parse(clearTextChoice);
                        for (const position in voteData) {
                            voteData[position].forEach(candidate => {
                                if (tallies[position] && tallies[position][candidate] !== undefined) tallies[position][candidate]++;
                            });
                        }
                    });
                }

                if (decryptionFailed) return res.status(401).json({ success: false, message: "Tokens are incorrect or missing. Access denied." });
                
                // Officially archive the election if it was active
                if (elec.status === 'Active') {
                    pool.query(`UPDATE ELECTION SET status = 'Completed' WHERE election_id = ?`, [elec.election_id]);
                }
                
                logActivity('SUPERADMIN', `Disclosed election results: ${elec.title}`, req.ip);
                res.json({ success: true, results: tallies, title: elec.title, message: "Results unlocked!" });
            });
        });
    });
});




